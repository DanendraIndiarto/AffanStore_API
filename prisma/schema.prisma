// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Enum Role
enum Role {
  USER
  ADMIN
}

// Enum Status Order
enum OrderStatus {
  PENDING    // Menunggu pembayaran (QRIS) atau menunggu pengiriman (COD)
  PAID       // Sudah dibayar
  CANCELLED  // Dibatalkan
}

// Enum Metode Pembayaran
enum PaymentMethod {
  CASH
  QRIS
}

// Enum Jenis Pengiriman
enum ShippingType {
  COD
  NON_COD
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  description String?     @db.Text
  price       Int
  category    String
  stock       Int         @default(0)
  imageUrl    String?
  isActive    Boolean     @default(true) // Untuk soft delete agar produk bisa disembunyikan tanpa merusak riwayat transaksi
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount   Int
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(QRIS)
  shippingType  ShippingType  @default(NON_COD)
  orderItems    OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict) // Menjaga integritas data transaksi
  quantity  Int     @default(1)
  price     Int
}